{
  "name": "airbnb",
  "version": "1.0.0",
  "description": "AirBnB Chicago Crime Analysis with D3.js Visualizations",
  "scripts": {
    "dev": "parcel src/index.html --open",
    "dev:dashboard": "parcel src/dashboard.html --open",
    "dev:simple": "parcel src/simple_viz/index.html --open",
    "build": "parcel build src/index.html --public-url ./",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "start": "parcel src/index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkusStefan/AirBnB.git"
  },
  "keywords": [
    "d3",
    "data-visualization",
    "airbnb",
    "chicago"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MarkusStefan/AirBnB/issues"
  },
  "homepage": "https://MarkusStefan.github.io/AirBnB",
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@parcel/transformer-raw": "^2.16.0",
    "gh-pages": "^6.3.0",
    "parcel": "^2.16.0",
    "parcel-reporter-static-files-copy": "^1.5.3"
  },
  "staticFiles": {
    "staticPath": "src/data",
    "staticOutDir": "data"
  }
}